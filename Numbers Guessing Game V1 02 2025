import random
import art

def compare_nums(difficulty, computer_number_1, computer_number_2):
    if difficulty == "easy":
        print(art.logo)
        print("Looking to play Easy huh?! You have 10 guesses\n")
        print("I'm thinking of a number between 0 and 100.\n")
        #guess1 = int(input("What's your guess?"))
        guess_counter_easy = 10
        while guess_counter_easy != 0:
            guess1 = int(input("What's your guess?"))
            if computer_number_1 == guess1:
                print( "Wow thats the number! Great guess!\n")
                print(f"You did that in {guess_counter_easy} guess's GG")
                return "You've Won"
            elif computer_number_1 > guess1:
                print("You're to low, guess higher!\n")
                print(f"You now have {guess_counter_easy - 1} Guess's left. Make them count")
            elif computer_number_1 < guess1:
                print("You're to high, drop that number.\n")
                print(f"You now have {guess_counter_easy - 1} Guess's left. Make them count")

            guess_counter_easy -= 1

        return print(f"\n\nYou couldn't geuss it in 10 that's way easier than Hard. You lose, loser. \nComputers number all along was {computer_number_1}")

    else:
        print(art.logo)
        print("Looking to play Hard huh? You have 5 guesses!\n")
        print("I'm thinking of a number between 1 and 1111.\n")
        guess_counter = 5
        while guess_counter != 0:
            guess2 = int(input("Whats your guess?"))
            if guess2 == computer_number_2:
                print(f"You got it exactly! Computers num was {computer_number_2}, yours {guess2}")
                return "Winner!!!"
            if guess2 > computer_number_2:
                print(f"Guess lower than {guess2}")
                print(f"You now have {guess_counter -1} Guess's left. Make them count")
            if guess2 < computer_number_2:
                print(f"Guess Higher than {guess2}")
                print(f"You now have {guess_counter -1} Guess's left. Make them count")
            #print(f"loops {guess2}")
            guess_counter -= 1

        return print(f"\n\nYou couldn't geuss it in 5. You lose, loser. \nComputer number was {computer_number_2}")



